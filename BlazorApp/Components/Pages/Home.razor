@page "/"
@using BlazorApp.Components.Shared
@using Logic

<PageTitle>Home</PageTitle>
<MudGrid>
    <MudItem xs="7">
        <div style="text-align: center">@_loadingStatus</div>
        <MudGrid>
            <MudItem>
                <RSelect T="Account" Label="Account" Items="_accounts" Value="_selectedAccount" ToStringFunc="account => account.DisplayName" ValueChanged="account => ChangeAccount(account)"/>
            </MudItem>
            <MudItem>
                <MudFileUpload T="IBrowserFile" Accept=".csv" FilesChanged="UploadFile" MaximumFileCount="100">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload">
                            New Bank file
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
            </MudItem>
            <MudItem>
                <RButton OnClick="CreateAccountYear">Create New Year</RButton>
                <RButton OnClick="CreateAccount">Create New Account</RButton>
            </MudItem>
        </MudGrid>
        @if (_accounts != null)
        {
            if (_selectedAccount != null)
            {
                <MudDataGrid Dense Height="100vh" Striped T="FinancialRecord" Items="_selectedAccount.Records.OrderByDescending(x => x.BankEntry.Date)" RowClick="SelectRow" SelectOnRowClick="true">
                    <Columns>
                        <PropertyColumn Property="x => x.BankEntry.Date" Title="Date" CellClass="f10"/>
                        <PropertyColumn Property="x => x.BankEntry.Text" Title="Text" CellClass="f10" />
                        <TemplateColumn Title="Amount" CellClass="f10">
                            <CellTemplate>
                                <div style="@($"color : {(context.Item.BankEntry.Amount > 0 ? "green" : "red")}")" class="align-end">@context.Item.BankEntry.Amount</div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Company" CellClass="f10">
                            <CellTemplate>
                                @context.Item.Company
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Description" CellClass="f10">
                            <CellTemplate>
                                @if (string.IsNullOrWhiteSpace(context.Item.Description))
                                {
                                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="@context.Item.Description"/>
                                }
                                else
                                {
                                    @context.Item.Description
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Category" CellClass="f10">
                            <CellTemplate>
                                @context.Item.Category
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Attachment" CellClass="f10">
                            <CellTemplate>
                                @context.Item.PotentialAttachment
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            }
        }
        else
        {
            <MudProgressLinear Indeterminate/>
        }
    </MudItem>

    <MudItem xs="5" Style="height: 100vh">
        @if (!string.IsNullOrWhiteSpace(_selectedRecord?.PotentialAttachment))
        {
            <h2>@_selectedRecord.Company | @_selectedRecord.Description | @Math.Abs(_selectedRecord.BankEntry.Amount) DKK</h2>

            <iframe height="100%" src="@("/pdf/" + _selectedRecord.PotentialAttachment)">
            </iframe>
        }
        else
        {
            <div>Select record with attachment</div>
        }
    </MudItem>
    }
</MudGrid>